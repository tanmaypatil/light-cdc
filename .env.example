# Copy to .env and fill in values

# Target database connection URLs
DEV_DATABASE_URL=postgresql://lightcdc:lightcdc_dev_pw@localhost:5432/lightcdc_dev
QA_DATABASE_URL=postgresql://lightcdc:lightcdc_qa_pw@localhost:5432/lightcdc_qa

# SQLite snapshot store location (local path)
SQLITE_DATA_DIR=./data

# Path to watch.json
WATCH_CONFIG_PATH=./watch.json

# Logging
LOG_LEVEL=DEBUG

# Anthropic API key (required for agentic features, optional for core CDC)
# ANTHROPIC_API_KEY=sk-ant-...
